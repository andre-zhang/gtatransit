# ── Neon Postgres (Vercel Marketplace: Storage → Neon) ─────────────────────
# After linking Neon on Vercel, run:  vercel env pull .env.local
# Vercel auto-injects the POSTGRES_* vars below into Production/Preview/Development.

# Pooled — use for Next.js API routes / serverless runtime
DATABASE_URL=
POSTGRES_URL=
POSTGRES_PRISMA_URL=

# Direct — use for migrations and GTFS import (PostGIS CREATE EXTENSION)
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=

# Discrete parts (optional; used if full URLs are not set)
POSTGRES_HOST=
POSTGRES_HOST_UNPOOLED=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Neon-native aliases (optional; same values as POSTGRES_* when using Neon integration)
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=
NEON_HOST=
NEON_HOST_UNPOOLED=
NEON_USER=
NEON_PASSWORD=
NEON_DATABASE=
NEON_PROJECT_ID=
NEON_API_KEY=

# ── Local Docker PostGIS (alternative to Neon for dev) ─────────────────────
# DATABASE_URL=postgresql://gta:gta@localhost:5433/gta_transit

# ── App ────────────────────────────────────────────────────────────────────
# Force demo fixtures even when DATABASE_URL is set:
# DEMO_MODE=1
# Force database mode even without env (not recommended):
# DEMO_MODE=0

METROLINX_API_KEY=
YRT_GTFS_ZIP=
GTFS_DATA_DIR=./data/gtfs
